{
  "name": "pw-principles",
  "label": "Principle grid (ten icons)",
  "description": "Section with label, rule, headline, intro, a grid of principles (icon, number, name, one line) and an italic closing line. Icons are the wireframe sketches until the brand-kit SVGs are uploaded per item.",
  "version": 1,
  "category": "power-with",
  "fields": {
    "closing": {
      "kind": "text",
      "label": "Italic closing line",
      "optional": true,
      "maxLength": 160
    },
    "ground": {
      "kind": "select",
      "label": "Section background",
      "options": [
        {
          "value": "obsidian",
          "label": "Ink (blue black)"
        },
        {
          "value": "bone",
          "label": "Linen (light)"
        },
        {
          "value": "sand",
          "label": "Sand (warm light)"
        },
        {
          "value": "olive",
          "label": "Spruce (deep green)"
        },
        {
          "value": "oxblood",
          "label": "Oxblood (deep red)"
        },
        {
          "value": "umber",
          "label": "Mulberry (plum)"
        },
        {
          "value": "clay",
          "label": "Clay (accent)"
        },
        {
          "value": "sage",
          "label": "Sage (grey green)"
        }
      ],
      "display": "dropdown"
    },
    "headline": {
      "kind": "text",
      "label": "Section headline",
      "maxLength": 140
    },
    "intro": {
      "kind": "text",
      "label": "Introduction",
      "optional": true,
      "maxLength": 320,
      "multiline": true
    },
    "items": {
      "kind": "list",
      "label": "Principles",
      "fields": {
        "customIcon": {
          "kind": "image",
          "label": "Or upload your own icon (SVG or PNG)",
          "optional": true
        },
        "icon": {
          "kind": "select",
          "label": "Icon sketch",
          "options": [
            {
              "value": "i1",
              "label": "01 Waves"
            },
            {
              "value": "i2",
              "label": "02 Overlap with small circle"
            },
            {
              "value": "i3",
              "label": "03 Arcs"
            },
            {
              "value": "i4",
              "label": "04 Circle over a line"
            },
            {
              "value": "i5",
              "label": "05 Eye"
            },
            {
              "value": "i6",
              "label": "06 Three circles"
            },
            {
              "value": "i7",
              "label": "07 Split circle"
            },
            {
              "value": "i8",
              "label": "08 Two linked rings"
            },
            {
              "value": "i9",
              "label": "09 Circle and spiral arc"
            },
            {
              "value": "i10",
              "label": "10 Return arrow"
            },
            {
              "value": "none",
              "label": "None"
            }
          ],
          "display": "dropdown"
        },
        "line": {
          "kind": "text",
          "label": "One line",
          "maxLength": 120
        },
        "name": {
          "kind": "text",
          "label": "Name",
          "maxLength": 40
        },
        "number": {
          "kind": "text",
          "label": "Number",
          "maxLength": 4
        }
      },
      "min": 1,
      "max": 12,
      "itemLabel": "name"
    },
    "kicker": {
      "kind": "text",
      "label": "Small label above the headline",
      "optional": true,
      "maxLength": 60
    }
  },
  "defaults": {
    "closing": "Each return is the practice.",
    "ground": "umber",
    "headline": "Ten capacities make power with possible.",
    "intro": "Each principle is a practice. Each one closes with a single action you can begin today. Together they build the capacity to stay connected under pressure.",
    "items": [
      {
        "icon": "i1",
        "line": "Staying present through discomfort.",
        "name": "EMOTIONAL REGULATION",
        "number": "01"
      },
      {
        "icon": "i2",
        "line": "Prioritizing another's experience when it matters most.",
        "name": "EMPATHY",
        "number": "02"
      },
      {
        "icon": "i3",
        "line": "Receiving another person's world.",
        "name": "LISTENING",
        "number": "03"
      },
      {
        "icon": "i4",
        "line": "Remaining teachable while staying yourself.",
        "name": "HUMILITY",
        "number": "04"
      },
      {
        "icon": "i5",
        "line": "Holding more than one perspective.",
        "name": "UNDERSTANDING",
        "number": "05"
      },
      {
        "icon": "i6",
        "line": "Transforming control into connection.",
        "name": "RELATIONALITY",
        "number": "06"
      },
      {
        "icon": "i7",
        "line": "Aligning word, action and energy.",
        "name": "INTEGRITY",
        "number": "07"
      },
      {
        "icon": "i8",
        "line": "Building safety through consistency, transparency and care.",
        "name": "TRUST",
        "number": "08"
      },
      {
        "icon": "i9",
        "line": "Owning your impact.",
        "name": "RESPONSIBILITY",
        "number": "09"
      },
      {
        "icon": "i10",
        "line": "Coming back.",
        "name": "REPAIR",
        "number": "10"
      }
    ],
    "kicker": "THE TEN PRINCIPLES"
  },
  "template": "<div class=\"pw\" data-ground=\"{{ground}}\"><div class=\"pw__in\">{{#if kicker}}<p class=\"pw__kicker os-type-eyebrow\">{{kicker}}</p>{{/if}}<div class=\"pw__rule\"></div><h2 class=\"pw__h2 os-type-h2\">{{headline}}</h2>{{#if intro}}<p class=\"pw__intro os-type-body\">{{intro}}</p>{{/if}}<div class=\"pw__grid\">{{#each items}}<div class=\"pw__it\"><div class=\"pw__ic\" data-icon=\"{{icon}}\"><svg class=\"i1\" width=\"48\" height=\"48\" viewBox=\"0 0 48 48\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"><path d=\"M8 16 Q16 8 24 16 T40 16\"></path><path d=\"M8 26 Q16 21 24 26 T40 26\"></path><line x1=\"8\" y1=\"36\" x2=\"40\" y2=\"36\"></line></svg><svg class=\"i2\" width=\"48\" height=\"48\" viewBox=\"0 0 48 48\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><circle cx=\"19\" cy=\"24\" r=\"10\"></circle><circle cx=\"29\" cy=\"24\" r=\"10\"></circle><circle cx=\"24\" cy=\"24\" r=\"2.5\"></circle></svg><svg class=\"i3\" width=\"48\" height=\"48\" viewBox=\"0 0 48 48\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"><path d=\"M22 13 A11 11 0 1 0 22 35\"></path><path d=\"M29 18 Q33 24 29 30\"></path><path d=\"M35 14 Q41 24 35 34\"></path></svg><svg class=\"i4\" width=\"48\" height=\"48\" viewBox=\"0 0 48 48\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"><circle cx=\"24\" cy=\"24\" r=\"10\"></circle><line x1=\"8\" y1=\"34\" x2=\"40\" y2=\"34\"></line></svg><svg class=\"i5\" width=\"48\" height=\"48\" viewBox=\"0 0 48 48\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M8 24 Q24 10 40 24 Q24 38 8 24 Z\"></path><circle cx=\"24\" cy=\"24\" r=\"4\"></circle></svg><svg class=\"i6\" width=\"48\" height=\"48\" viewBox=\"0 0 48 48\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><circle cx=\"19\" cy=\"20\" r=\"9\"></circle><circle cx=\"29\" cy=\"20\" r=\"9\"></circle><circle cx=\"24\" cy=\"29\" r=\"9\"></circle></svg><svg class=\"i7\" width=\"48\" height=\"48\" viewBox=\"0 0 48 48\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"><circle cx=\"24\" cy=\"24\" r=\"12\"></circle><line x1=\"24\" y1=\"12\" x2=\"24\" y2=\"36\"></line></svg><svg class=\"i8\" width=\"48\" height=\"48\" viewBox=\"0 0 48 48\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><circle cx=\"18\" cy=\"24\" r=\"9\"></circle><circle cx=\"30\" cy=\"24\" r=\"9\"></circle></svg><svg class=\"i9\" width=\"48\" height=\"48\" viewBox=\"0 0 48 48\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"><circle cx=\"24\" cy=\"24\" r=\"1.8\" fill=\"currentColor\"></circle><circle cx=\"24\" cy=\"24\" r=\"8\"></circle><path d=\"M24 8 A16 16 0 1 1 10 32\"></path></svg><svg class=\"i10\" width=\"48\" height=\"48\" viewBox=\"0 0 48 48\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"><path d=\"M31 13 A12 12 0 1 0 36 25\"></path><path d=\"M31 13 Q39 15 36 25\"></path><line x1=\"32\" y1=\"16\" x2=\"36\" y2=\"15\"></line><line x1=\"34\" y1=\"21\" x2=\"38\" y2=\"21\"></line></svg></div>{{#if customIcon}}<div class=\"pw__cic\">{{image customIcon sizes=\"96px\"}}</div>{{/if}}<p class=\"pw__nm os-type-eyebrow\">{{number}} {{name}}</p><p class=\"pw__ln os-type-body\">{{line}}</p></div>{{/each}}</div>{{#if closing}}<p class=\"pw__close os-type-h3\">{{closing}}</p>{{/if}}</div></div>",
  "css": ":scope{display:block;width:100%}\n.pw{--bg:#01111D;--tx:#EDE6D8;--lb:#BBAFA3;--rl:#C6A15B;--hl:#7B868066;--ic:#7B8680;background:var(--bg);color:var(--tx);font-family:var(--os-font-body);font-weight:400}\n.pw[data-ground=\"bone\"]{--bg:#E0D9CB;--tx:#01111D;--lb:#5E3A3C;--rl:#8C5B46;--hl:#BBAFA3;--ic:#5E3A3C}\n.pw[data-ground=\"sand\"]{--bg:#BBAFA3;--tx:#01111D;--lb:#5E3A3C;--rl:#01111D;--hl:#01111D40;--ic:#5E3A3C}\n.pw[data-ground=\"olive\"]{--bg:#182727}\n.pw[data-ground=\"oxblood\"]{--bg:#321013;--hl:#95665A;--ic:#95665A}\n.pw[data-ground=\"umber\"]{--bg:#5E3A3C;--rl:#BBAFA3;--hl:#BBAFA366;--ic:#BBAFA3}\n.pw[data-ground=\"clay\"]{--bg:#8C5B46;--lb:#EDE6D8;--rl:#EDE6D8;--hl:#EDE6D899;--ic:#EDE6D8}\n.pw[data-ground=\"sage\"]{--bg:#7B8680;--tx:#01111D;--lb:#01111D;--rl:#01111D;--hl:#01111D40;--ic:#01111D}\n.pw__in{box-sizing:content-box;max-width:1200px;margin:0 auto;padding:128px 32px}\n.pw__kicker{margin:0;font-family:var(--os-font-label);font-weight:400;font-size:var(--os-type-eyebrow-font-size);letter-spacing:.32em;text-transform:uppercase;color:var(--lb)}\n.pw__rule{width:64px;height:1px;background:var(--rl);margin:28px 0 32px}\n.pw__in>.pw__rule:first-child{margin-top:0}\n.pw__h2{margin:0;font-family:var(--os-font-heading);font-weight:500;font-size:var(--os-type-h2-font-size);line-height:var(--os-type-h2-line-height);color:var(--tx);text-wrap:balance}\n.pw__intro{margin:24px 0 0;font-size:var(--os-type-body-font-size);line-height:var(--os-type-body-line-height);max-width:34em}\n.pw__grid{display:grid;gap:48px 32px;grid-template-columns:repeat(5,minmax(0,1fr));margin-top:72px}\n.pw__it{border-top:1px solid var(--hl);padding-top:24px}\n.pw__ic{color:var(--ic);line-height:0}\n.pw__ic svg{display:none}\n.pw__ic[data-icon=\"i1\"] .i1,.pw__ic[data-icon=\"i2\"] .i2,.pw__ic[data-icon=\"i3\"] .i3,.pw__ic[data-icon=\"i4\"] .i4,.pw__ic[data-icon=\"i5\"] .i5,.pw__ic[data-icon=\"i6\"] .i6,.pw__ic[data-icon=\"i7\"] .i7,.pw__ic[data-icon=\"i8\"] .i8,.pw__ic[data-icon=\"i9\"] .i9,.pw__ic[data-icon=\"i10\"] .i10{display:block}\n.pw__ic[data-icon=\"none\"]{display:none}\n.pw__cic{line-height:0}\n.pw__cic img{display:block;width:48px;height:48px;object-fit:contain}\n.pw__nm{margin:18px 0 0;font-family:var(--os-font-label);font-weight:400;font-size:var(--os-type-eyebrow-font-size);letter-spacing:.2em;text-transform:uppercase;color:var(--lb)}\n.pw__ln{margin:8px 0 0;font-size:var(--os-type-body-font-size);line-height:var(--os-type-body-line-height)}\n.pw__close{margin:72px 0 0;font-family:var(--os-font-heading);font-style:italic;font-weight:500;font-size:var(--os-type-h3-font-size);line-height:var(--os-type-h3-line-height)}\n@media (max-width:1199px){.pw__grid{grid-template-columns:repeat(3,minmax(0,1fr))}}\n@media (max-width:767px){.pw__in{padding:64px 20px}\n.pw__kicker{letter-spacing:.24em}\n.pw__rule{width:48px;margin:24px 0}\n.pw__intro{margin-top:20px}\n.pw__grid{grid-template-columns:1fr;gap:28px;margin-top:40px}\n.pw__it{display:grid;grid-template-columns:48px 1fr;column-gap:20px;align-items:start}\n.pw__ic,.pw__cic{grid-row:span 2}\n.pw__nm{margin-top:4px}\n.pw__close{margin-top:40px}}",
  "section": {
    "width": "full",
    "padding": {
      "d": "none",
      "m": "none"
    }
  },
  "ai": {
    "purpose": "Grid of ten principles with icons.",
    "whenToUse": "A grid of short labelled items each with a small icon."
  }
}
