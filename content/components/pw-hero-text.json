{
  "name": "pw-hero-text",
  "label": "Hero (gold sigil, title, subtitle, lead, body)",
  "description": "The home hero: a large gold hairline sigil whose two circles draw together as the page opens, then label, title, italic subtitle, lead line, paragraph and a caption for the sign-up field below. Centred or left aligned.",
  "version": 2,
  "category": "power-with",
  "fields": {
    "align": {
      "kind": "select",
      "label": "Alignment",
      "options": [
        {
          "value": "center",
          "label": "Centred"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "display": "segmented"
    },
    "body": {
      "kind": "text",
      "label": "Paragraph",
      "optional": true,
      "maxLength": 520,
      "multiline": true
    },
    "formLabel": {
      "kind": "text",
      "label": "Caption above the email field (sighted visitors)",
      "optional": true,
      "maxLength": 60
    },
    "kicker": {
      "kind": "text",
      "label": "Small label",
      "optional": true,
      "maxLength": 60
    },
    "lead": {
      "kind": "text",
      "label": "Lead line",
      "optional": true,
      "maxLength": 200,
      "multiline": true
    },
    "showSigil": {
      "kind": "boolean",
      "label": "Show the gold sigil"
    },
    "subtitle": {
      "kind": "text",
      "label": "Italic subtitle",
      "optional": true,
      "maxLength": 120
    },
    "title": {
      "kind": "text",
      "label": "Title",
      "maxLength": 80
    }
  },
  "defaults": {
    "align": "center",
    "body": "",
    "formLabel": "FREE · THE SPOKEN WORD",
    "kicker": "A BOOK BY SOPHIA LIFE · JANUARY 2027",
    "lead": "The strategies that build success often erode the relationships success depends on.",
    "showSigil": true,
    "subtitle": "The Relational Foundation of Lasting Influence",
    "title": "Power With"
  },
  "template": "<div class=\"pw\" data-align=\"{{align}}\">{{#if showSigil}}<svg class=\"pw__sig\" viewBox=\"0 0 120 80\" aria-hidden=\"true\"><circle class=\"pw__c pw__c1\" cx=\"46\" cy=\"40\" r=\"28\"></circle><circle class=\"pw__c pw__c2\" cx=\"74\" cy=\"40\" r=\"28\"></circle></svg>{{/if}}{{#if kicker}}<p class=\"pw__kicker\">{{kicker}}</p>{{/if}}<h1 class=\"pw__h1\">{{title}}</h1>{{#if subtitle}}<p class=\"pw__sub\">{{subtitle}}</p>{{/if}}<div class=\"pw__rule\"></div>{{#if lead}}<p class=\"pw__lead\">{{lead}}</p>{{/if}}{{#if body}}<p class=\"pw__body\">{{body}}</p>{{/if}}{{#if formLabel}}<p class=\"pw__fl\" aria-hidden=\"true\">{{formLabel}}</p>{{/if}}</div>",
  "css": ":scope{display:block;width:100%}\n.pw{--gilt:#C6A15B;color:var(--os-color-text);font-family:var(--os-font-body);font-weight:400;display:flex;flex-direction:column;align-items:flex-start}\n.pw[data-align=\"center\"]{align-items:center;text-align:center}\n.pw__sig{display:block;width:220px;height:auto;margin:0 0 40px;overflow:visible}\n.pw__c{fill:none;stroke:var(--gilt);stroke-width:.7}\n.pw__c1{animation:pwL 1.8s cubic-bezier(.2,.7,.2,1) both}\n.pw__c2{animation:pwR 1.8s cubic-bezier(.2,.7,.2,1) both}\n@keyframes pwL{from{transform:translateX(-18px);opacity:0}to{transform:none;opacity:1}}\n@keyframes pwR{from{transform:translateX(18px);opacity:0}to{transform:none;opacity:1}}\n@media (prefers-reduced-motion:reduce){.pw__c1,.pw__c2{animation:none}}\n.pw__kicker{margin:0;font-family:var(--os-font-label);font-weight:400;font-size:12px;letter-spacing:.34em;text-transform:uppercase;color:var(--os-color-text-muted)}\n.pw__h1{margin:24px 0 0;font-family:var(--os-font-heading);font-weight:500;font-size:104px;line-height:.98;color:var(--os-color-heading);text-wrap:balance}\n.pw__sub{margin:18px 0 0;font-family:var(--os-font-heading);font-style:italic;font-weight:500;font-size:30px;line-height:1.2;color:var(--os-color-text-muted)}\n.pw__rule{width:64px;height:1px;background:var(--gilt);margin:40px 0 36px}\n.pw__lead{margin:0;font-family:var(--os-font-heading);font-weight:500;font-size:34px;line-height:1.22;max-width:22em;text-wrap:balance}\n.pw__body{margin:24px 0 0;font-size:21px;line-height:1.5;max-width:34em}\n.pw__fl{margin:44px 0 -4px;font-family:var(--os-font-label);font-size:12px;letter-spacing:.3em;text-transform:uppercase;color:var(--os-color-text-muted)}\n@media (max-width:767px){.pw__sig{width:130px;margin-bottom:24px}.pw__kicker{font-size:12px;letter-spacing:.22em}.pw__h1{font-size:46px;line-height:1.02;margin-top:16px}.pw__sub{font-size:21px}.pw__rule{width:48px;margin:24px 0}.pw__lead{font-size:24px}.pw__body{font-size:19px}.pw__fl{margin-top:28px}}",
  "section": {
    "width": "full",
    "padding": {
      "d": "none",
      "m": "none"
    }
  },
  "ai": {
    "purpose": "Text half of the home hero.",
    "whenToUse": "Hero with a sign-up form block placed below."
  },
  "migrations": {
    "1": {
      "set": {
        "align": "center",
        "showSigil": true
      }
    }
  }
}
