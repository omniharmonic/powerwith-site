{
  "name": "pw-sticky-bar",
  "label": "Sticky bar (phones only)",
  "description": "A bar fixed to the bottom of the screen on phones with a short label and a button. Hidden on tablets and desktops.",
  "version": 1,
  "category": "power-with",
  "fields": {
    "buttonLabel": {
      "kind": "text",
      "label": "Button text",
      "maxLength": 30
    },
    "buttonLink": {
      "kind": "link",
      "label": "Where the button goes"
    },
    "label": {
      "kind": "text",
      "label": "Label",
      "maxLength": 40
    }
  },
  "defaults": {
    "buttonLabel": "GET THE WORDS",
    "buttonLink": {
      "anchor": "spoken-word",
      "page": "pg_eq7h19rjgt",
      "type": "page"
    },
    "label": "FREE · THE SPOKEN WORD"
  },
  "template": "<div class=\"pw\"><span class=\"pw__l\">{{label}}</span><a class=\"pw__b\" href=\"{{href buttonLink}}\">{{buttonLabel}}</a></div>",
  "css": ":scope{display:block;width:100%}.pw{display:none}\n@media (max-width:767px){.pw{display:flex;position:fixed;left:0;right:0;bottom:0;z-index:50;background:#01111D;border-top:1px solid #C6A15B66;padding:10px 16px;align-items:center;justify-content:space-between;gap:12px;box-sizing:border-box;transform:translateY(110%);transition:transform .35s ease}.pw.is-on{transform:none}.pw__l{flex:1 1 auto;min-width:0;font-family:var(--os-font-label);font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:#BBAFA3;line-height:1.35}.pw__b{flex:0 0 auto;font-family:var(--os-font-label);font-size:12px;letter-spacing:.14em;text-transform:uppercase;text-decoration:none;color:#EDE6D8;background:#8C5B46;padding:14px 16px;min-height:44px;box-sizing:border-box;display:inline-flex;align-items:center;white-space:nowrap}.pw__b:focus-visible{outline:2px solid #EDE6D8;outline-offset:2px}}\n@media (max-width:767px) and (prefers-reduced-motion:reduce){.pw{transition:none}}",
  "js": "var bar=(root.classList&&root.classList.contains('pw'))?root:root.querySelector('.pw');if(!bar)return;var t=function(){bar.classList.toggle('is-on',window.scrollY>window.innerHeight*0.9)};window.addEventListener('scroll',t,{passive:true});t();",
  "section": {
    "width": "full",
    "padding": {
      "d": "none",
      "m": "none"
    }
  },
  "ai": {
    "purpose": "Phone-only sticky call to action.",
    "whenToUse": "Home page on phones."
  }
}
