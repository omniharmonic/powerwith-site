{
  "name": "pw-quote",
  "label": "Quote band",
  "description": "Centred or left large quote with a small attribution. Choose the ground.",
  "version": 1,
  "category": "power-with",
  "fields": {
    "align": {
      "kind": "select",
      "label": "Alignment",
      "options": [
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "display": "segmented"
    },
    "attribution": {
      "kind": "text",
      "label": "Attribution",
      "optional": true,
      "maxLength": 60
    },
    "ground": {
      "kind": "select",
      "label": "Section background",
      "options": [
        {
          "value": "obsidian",
          "label": "Ink (blue black)"
        },
        {
          "value": "bone",
          "label": "Linen (light)"
        },
        {
          "value": "sand",
          "label": "Sand (warm light)"
        },
        {
          "value": "olive",
          "label": "Spruce (deep green)"
        },
        {
          "value": "oxblood",
          "label": "Oxblood (deep red)"
        },
        {
          "value": "umber",
          "label": "Mulberry (plum)"
        },
        {
          "value": "clay",
          "label": "Clay (accent)"
        },
        {
          "value": "sage",
          "label": "Sage (grey green)"
        },
        {
          "value": "rose",
          "label": "Rosewood (large quotes only)"
        }
      ],
      "display": "dropdown"
    },
    "quote": {
      "kind": "text",
      "label": "Quote",
      "maxLength": 240,
      "multiline": true
    }
  },
  "defaults": {
    "align": "center",
    "attribution": "FROM POWER WITH",
    "ground": "oxblood",
    "quote": "What looks like confidence is often defense with good posture."
  },
  "template": "<div class=\"pw\" data-ground=\"{{ground}}\" data-align=\"{{align}}\"><div class=\"pw__in\"><div class=\"pw__rule\"></div><p class=\"pw__q\">{{quote}}</p>{{#if attribution}}<p class=\"pw__by os-type-eyebrow\">{{attribution}}</p>{{/if}}</div></div>",
  "css": ":scope{display:block;width:100%}\n.pw{--bg:#01111D;--tx:#EDE6D8;--lb:#BBAFA3;--rl:#C6A15B;background:var(--bg);color:var(--tx);font-family:var(--os-font-body)}\n.pw[data-ground=\"bone\"]{--bg:#E0D9CB;--tx:#01111D;--lb:#5E3A3C;--rl:#8C5B46}\n.pw[data-ground=\"sand\"]{--bg:#BBAFA3;--tx:#01111D;--lb:#5E3A3C;--rl:#01111D}\n.pw[data-ground=\"olive\"]{--bg:#182727}\n.pw[data-ground=\"oxblood\"]{--bg:#321013}\n.pw[data-ground=\"umber\"]{--bg:#5E3A3C;--rl:#BBAFA3}\n.pw[data-ground=\"clay\"]{--bg:#8C5B46;--lb:#EDE6D8;--rl:#EDE6D8}\n.pw[data-ground=\"sage\"]{--bg:#7B8680;--tx:#01111D;--lb:#01111D;--rl:#01111D}\n.pw[data-ground=\"rose\"]{--bg:#95665A;--tx:#01111D;--lb:#01111D;--rl:#01111D}\n.pw__in{box-sizing:content-box;max-width:900px;margin:0 auto;padding:120px 32px}\n.pw[data-align=\"center\"] .pw__in{text-align:center}\n.pw__rule{width:48px;height:1px;background:var(--rl);margin:0 0 40px}\n.pw[data-align=\"center\"] .pw__rule{margin-left:auto;margin-right:auto}\n.pw__q{margin:0;font-family:var(--os-font-heading);font-weight:500;font-size:calc(var(--os-type-h2-font-size) * 0.867);line-height:1.12;text-wrap:balance}\n.pw__by{margin:32px 0 0;font-family:var(--os-font-label);font-size:var(--os-type-eyebrow-font-size);letter-spacing:.32em;text-transform:uppercase;color:var(--lb)}\n@media (max-width:767px){.pw__in{padding:72px 20px}\n.pw__rule{margin-bottom:28px}\n.pw__by{margin-top:20px;letter-spacing:.24em}}",
  "section": {
    "width": "full",
    "padding": {
      "d": "none",
      "m": "none"
    }
  },
  "ai": {
    "purpose": "Large quote band.",
    "whenToUse": "A single pull quote between sections."
  }
}
