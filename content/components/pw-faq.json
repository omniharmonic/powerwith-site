{
  "name": "pw-faq",
  "label": "Questions grid",
  "description": "A small label and rule, then questions with answers laid out in two columns.",
  "version": 1,
  "category": "power-with",
  "fields": {
    "items": {
      "kind": "list",
      "label": "Questions",
      "fields": {
        "answer": {
          "kind": "text",
          "label": "Answer",
          "maxLength": 400,
          "multiline": true
        },
        "question": {
          "kind": "text",
          "label": "Question",
          "maxLength": 120
        }
      },
      "min": 1,
      "max": 12,
      "itemLabel": "question"
    },
    "kicker": {
      "kind": "text",
      "label": "Small label",
      "maxLength": 60
    }
  },
  "defaults": {
    "items": [
      {
        "answer": "Pre-orders ship on publication day in January 2027. [Exact date to confirm.]",
        "question": "When will my copy arrive?"
      },
      {
        "answer": "Every pre-order, in any format, from any retailer.",
        "question": "Which formats include the Orientation?"
      },
      {
        "answer": "Yes. An audiobook is planned, and readers on the list will hear first.",
        "question": "Is there an audiobook?"
      },
      {
        "answer": "Yes. Orders of ten or more receive tier pricing and a reading guide.",
        "question": "Can my company order in bulk?"
      }
    ],
    "kicker": "QUESTIONS"
  },
  "template": "<div class=\"pw\"><div class=\"pw__in\"><p class=\"pw__kicker os-type-eyebrow\">{{kicker}}</p><div class=\"pw__rule\"></div><div class=\"pw__grid\">{{#each items}}<div class=\"pw__q\"><h3 class=\"pw__qh os-type-h4\">{{question}}</h3><p class=\"pw__qa os-type-body\">{{answer}}</p></div>{{/each}}</div></div></div>",
  "css": ":scope{display:block;width:100%}\n.pw{background:#01111D;color:#EDE6D8;font-family:var(--os-font-body)}\n.pw__in{box-sizing:content-box;max-width:1200px;margin:0 auto;padding:104px 32px 112px}\n.pw__kicker{margin:0;font-family:var(--os-font-label);font-weight:400;font-size:var(--os-type-eyebrow-font-size);letter-spacing:.32em;text-transform:uppercase;color:#BBAFA3}\n.pw__rule{width:64px;height:1px;background:#C6A15B;margin:28px 0 40px}\n.pw__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:40px 56px}\n.pw__q{border-top:1px solid #7B868066;padding-top:24px}\n.pw__qh{margin:0;font-family:var(--os-font-heading);font-weight:500;font-size:var(--os-type-h4-font-size);line-height:var(--os-type-h4-line-height);color:#EDE6D8}\n.pw__qa{margin:10px 0 0;font-size:var(--os-type-body-font-size);line-height:var(--os-type-body-line-height);color:#BBAFA3}\n@media (max-width:767px){.pw__in{padding:56px 20px 72px}\n.pw__grid{grid-template-columns:1fr;gap:28px}\n.pw__kicker{letter-spacing:.24em}\n.pw__rule{margin:20px 0 28px}}",
  "section": {
    "width": "full",
    "padding": {
      "d": "none",
      "m": "none"
    }
  },
  "ai": {
    "purpose": "FAQ grid.",
    "whenToUse": "Sales pages."
  }
}
