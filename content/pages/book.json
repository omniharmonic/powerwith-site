      "blocks": [
        {
          "id": "blk_3197h16f3d",
          "type": "component/pw-measures",
          "v": 1,
          "fields": {
            "closing": "These are the hardest measures there are.",
            "ground": "oxblood",
            "headline": "Success is measured in relationship.",
            "intro": "Power With offers five measures. Read them slowly. Notice which one stays with you.",
            "items": [
              {
                "text": "The safety people feel in your presence."
              },
              {
                "text": "The willingness of others to tell you what is actually happening."
              },
              {
                "text": "The quality of your attention when others speak."
              },
              {
                "text": "Your willingness to repair when you have caused harm."
              },
              {
                "text": "The depth of connection you sustain over time."
              }
            ],
            "kicker": "A NEW MEASURE"
          }
        }
      ]
    },
