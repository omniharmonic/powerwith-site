          "id": "blk_q3z5xmmqn8",
          "type": "component/pw-hero-text",
          "v": 2,
          "column": 0,
          "fields": {
            "body": "Power With is for leaders who have built a great deal and still sense that something essential remains out of reach. It shows you how to hold your influence so the people closest to you grow stronger in your presence.",
            "formLabel": "FREE · THE SPOKEN WORD",
            "kicker": "A BOOK BY SOPHIA LIFE · JANUARY 2027",
            "lead": "The strategies that build success often erode the relationships success depends on.",
            "subtitle": "The Relational Foundation of Lasting Influence",
            "title": "Power With",
            "align": "left",
            "showSigil": true
          }
        },
        {
          "id": "blk_ay2thycetx",
